#!/usr/bin/env bash
# Stand-in for $HG_TOOLS/bin/codex in package tests: replays a recorded codex JSONL
# stream and exits with a chosen code, optionally writing a file to the workspace first.
# The second call in a turn can replay a different stream (FAKE_CODEX_OUTPUT_2 / EXIT_2),
# so tests can drive the resume-refused fallback.
set -u
printf '%s\n' "$*" >> "${FAKE_CODEX_ARGV:-/tmp/fake-argv}"
calls=$(wc -l < "${FAKE_CODEX_ARGV:-/tmp/fake-argv}")
if [ "$calls" -gt 1 ] && [ -n "${FAKE_CODEX_OUTPUT_2:-}" ]; then
  output=${FAKE_CODEX_OUTPUT_2}
  exit_code=${FAKE_CODEX_EXIT_2:-${FAKE_CODEX_EXIT:-0}}
else
  output=${FAKE_CODEX_OUTPUT:-/dev/null}
  exit_code=${FAKE_CODEX_EXIT:-0}
fi
if [ -n "${FAKE_CODEX_SLEEP:-}" ]; then
  sleep "${FAKE_CODEX_SLEEP}"
fi
if [ -n "${FAKE_CODEX_STDIN_FILE:-}" ]; then
  cat > "${FAKE_CODEX_STDIN_FILE}"
fi
if [ -n "${FAKE_CODEX_WRITE_FILE:-}" ]; then
  printf '%s' "${FAKE_CODEX_WRITE_CONTENT:-}" > "${FAKE_CODEX_WRITE_FILE}"
fi
cat "$output"
exit "$exit_code"

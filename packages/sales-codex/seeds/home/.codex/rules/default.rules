# The sales agent's permission fence (Codex execpolicy prefix rules, applied without any prompt).
# The workspace-write sandbox additionally limits writes to the workspace, and the platform's egress
# door blocks all non-provider network traffic regardless. These rules make the refusals explicit.

# No remote operations on git.
prefix_rule(pattern = ["git", "push"], decision = "forbidden", justification = "No remote operations.")
prefix_rule(pattern = ["git", "pull"], decision = "forbidden", justification = "No remote operations.")
prefix_rule(pattern = ["git", "fetch"], decision = "forbidden", justification = "No remote operations.")
prefix_rule(pattern = ["git", "clone"], decision = "forbidden", justification = "No remote operations.")
prefix_rule(pattern = ["git", "remote"], decision = "forbidden", justification = "No remote operations.")
prefix_rule(pattern = ["git", "ls-remote"], decision = "forbidden", justification = "No remote operations.")
prefix_rule(pattern = ["git", "submodule"], decision = "forbidden", justification = "No remote operations.")

# No installing software at run time.
prefix_rule(pattern = ["npm", "install"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["npm", "i"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["npm", "add"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["npx"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["yarn", "add"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["pnpm", "add"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["bun", "add"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["pip", "install"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["pip3", "install"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["python3", "-m", "pip", "install"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["python", "-m", "pip", "install"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["apt"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["apt-get"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["yum"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["apk"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["brew"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["cargo", "install"], decision = "forbidden", justification = "No installing software.")
prefix_rule(pattern = ["go", "install"], decision = "forbidden", justification = "No installing software.")

# Nothing destructive, and no privilege escalation.
prefix_rule(pattern = ["rm", "-rf"], decision = "forbidden", justification = "No destructive removal.")
prefix_rule(pattern = ["rm", "-r", "-f"], decision = "forbidden", justification = "No destructive removal.")
prefix_rule(pattern = ["rm", "-fr"], decision = "forbidden", justification = "No destructive removal.")
prefix_rule(pattern = ["rm", "-Rf"], decision = "forbidden", justification = "No destructive removal.")
prefix_rule(pattern = ["dd"], decision = "forbidden", justification = "No destructive writes.")
prefix_rule(pattern = ["mkfs"], decision = "forbidden", justification = "No destructive writes.")
prefix_rule(pattern = ["shred"], decision = "forbidden", justification = "No destructive writes.")
prefix_rule(pattern = ["shutdown"], decision = "forbidden", justification = "No destructive actions.")
prefix_rule(pattern = ["reboot"], decision = "forbidden", justification = "No destructive actions.")
prefix_rule(pattern = ["poweroff"], decision = "forbidden", justification = "No destructive actions.")
prefix_rule(pattern = ["halt"], decision = "forbidden", justification = "No destructive actions.")
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "No privilege escalation.")
prefix_rule(pattern = ["su"], decision = "forbidden", justification = "No privilege escalation.")

# No contacting anything on the network (the platform's door blocks this too).
prefix_rule(pattern = ["curl"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["wget"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["nc"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["ncat"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["netcat"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["socat"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["ssh"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["scp"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["sftp"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["rsync"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["ftp"], decision = "forbidden", justification = "No network contact.")
prefix_rule(pattern = ["telnet"], decision = "forbidden", justification = "No network contact.")

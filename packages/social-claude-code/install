#!/bin/sh
# Installs Claude Code at a pinned version under /harness/tools, by its makers' documented method (npm).
set -eu
VERSION=2.1.323

for need in node npm python3; do
  command -v "$need" >/dev/null 2>&1 || {
    echo "this image has no $need: Claude Code needs Node.js 22 or later, and this package's run needs python3" >&2
    exit 1
  }
done

npm install --prefix /harness/tools --no-audit --no-fund --loglevel=error "@anthropic-ai/claude-code@$VERSION"

got=$(/harness/tools/node_modules/.bin/claude --version | awk '{print $1}')
[ "$got" = "$VERSION" ] || { echo "installed Claude Code $got, wanted $VERSION" >&2; exit 1; }
echo "Claude Code $got installed"

{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git clone:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(yum:*)",
      "Bash(dnf:*)",
      "Bash(cargo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(//etc/**)",
      "Write(//tmp/**)",
      "Write(//home/**)",
      "Write(//root/**)",
      "Write(//var/**)",
      "Read(~/.claude.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 $HOME/.claude/hooks/pre-tool-use.py"}]
      },
      {
        "matcher": "Write|Edit|MultiEdit|WebFetch",
        "hooks": [{"type": "command", "command": "python3 $HOME/.claude/hooks/pre-tool-use.py"}]
      }
    ]
  }
}

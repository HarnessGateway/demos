#!/usr/bin/env python3
"""journalist-pi: one turn of the commodities-market journalist. The request's assignment (with
metadata.desk and metadata.task) runs as pi; pi's JSON event stream is mapped to Responses events.
The agent authors its drafts into the workspace; it never publishes."""
import json
import os
import queue
import signal
import subprocess
import threading
import time

from hgkit import Emitter, Request

HG_TOOLS = os.environ.get("HG_TOOLS", "/opt/hg/tools")
PI = os.path.join(HG_TOOLS, "node_modules", ".bin", "pi")

# harness.json sets run.timeout_s 1200; leave a margin for the terminal event and a graceful SIGTERM.
TURN_TIMEOUT = 1140.0

BASH, WRITE, EDIT = "bash", "write", "edit"
IGNORED = ("temperature", "top_p", "max_output_tokens", "max_tool_calls", "text", "tools")
THINKING = {"none": "off", "off": "off", "minimal": "minimal", "low": "low", "medium": "medium",
            "high": "high", "xhigh": "xhigh"}


def write_models_json(url, model):
    """Point the anthropic provider at the gateway and register this turn's model (HG_MODEL)."""
    path = os.path.join(os.environ.get("HOME", "/root"), ".pi", "agent", "models.json")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    data = {
        "providers": {
            "anthropic": {
                "baseUrl": url,          # no /v1: pi appends /v1/messages
                "api": "anthropic-messages",
                "models": [{
                    "id": model, "name": model, "reasoning": True, "input": ["text"],
                    "contextWindow": 200000, "maxTokens": 16384,
                }],
            }
        }
    }
    with open(path, "w") as f:
        json.dump(data, f, indent=2)


def find_session_file(session_id):
    if not session_id:
        return None
    root = os.path.join(os.environ.get("HOME", "/root"), ".pi", "agent", "sessions")
    if not os.path.isdir(root):
        return None
    for dirpath, _dirs, files in os.walk(root):
        for name in files:
            if name.endswith(session_id + ".jsonl"):
                return os.path.join(dirpath, name)
    return None


def _text_of(result):
    out = []
    for c in (result or {}).get("content") or []:
        if isinstance(c, dict) and c.get("type") == "text":
            out.append(c.get("text", ""))
    return "\n".join(out)


def _edit_texts(args):
    edits = args.get("edits") if isinstance(args, dict) else None
    if isinstance(edits, list) and edits:
        olds, news = [], []
        for e in edits:
            if isinstance(e, dict):
                olds.append(str(e.get("oldText", "")))
                news.append(str(e.get("newText", "")))
        return "\n".join(olds), "\n".join(news)
    if isinstance(args, dict) and args.get("oldText") is not None:
        return str(args["oldText"]), str(args.get("newText", ""))
    return "", ""


def _error_code(msg):
    low = (msg or "").lower()
    if "401" in msg or "403" in msg or "auth" in low or "credential" in low:
        return "authentication_error"
    if "429" in msg or "rate" in low or "quota" in low or "overloaded" in low:
        return "rate_limit_exceeded"
    if "400" in msg or "invalid" in low:
        return "invalid_prompt"
    return "server_error"


def map_stream(lines, out, save_session=None):
    """Feed pi's JSON lines into the Responses emitter. Returns a summary of the turn."""
    state = {"streamed": False, "ended": False, "error": "",
             "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}}
    pending = {}
    for raw in lines:
        raw = raw.rstrip("\n")
        if not raw.strip():
            continue
        try:
            d = json.loads(raw)
        except ValueError:
            out.log("pi " + raw[:200])
            continue
        t = d.get("type")
        if t == "session":
            if save_session:
                save_session(d.get("id", ""))
            out.log("pi session " + str(d.get("id", "")))
        elif t == "message_update":
            ev = d.get("assistantMessageEvent") or {}
            et = ev.get("type")
            delta = ev.get("delta") or ""
            if et == "text_delta" and delta:
                out.say(delta)
                state["streamed"] = True
            elif et == "thinking_delta" and delta:
                out.think(delta)
        elif t == "message_end":
            m = d.get("message") or {}
            if m.get("role") == "assistant" and m.get("stopReason") == "error":
                state["error"] = (m.get("errorMessage") or "").strip() or "provider error"
        elif t == "tool_execution_start":
            name = d.get("toolName", "")
            args = d.get("args") if isinstance(d.get("args"), dict) else {}
            cid = d.get("toolCallId") or ""
            pending[cid] = (name, args, out.ran(str(args.get("command", ""))) if name == BASH else None)
        elif t == "tool_execution_end":
            cid = d.get("toolCallId") or ""
            name, args, run = pending.pop(cid, (None, None, None))
            if name is None:
                continue
            text = _text_of(d.get("result"))
            is_err = bool(d.get("isError"))
            if name == BASH:
                run.done(stdout=text, exit=1 if is_err else 0)
            elif name == WRITE:
                out.wrote(str(args.get("path", "")), str(args.get("content", "")),
                          ok=not is_err, output=text if is_err else "")
            elif name == EDIT:
                old, new = _edit_texts(args)
                out.edited(str(args.get("path", "")), old=old, new=new,
                           ok=not is_err, output=text if is_err else "")
            else:  # read, grep, find, ls
                out.used(name, args, text, ok=not is_err)
        elif t == "agent_end":
            state["ended"] = True
            final_text = ""
            for m in d.get("messages") or []:
                if m.get("role") != "assistant":
                    continue
                if m.get("stopReason") == "error":
                    state["error"] = (m.get("errorMessage") or "").strip() or "provider error"
                u = m.get("usage") or {}
                for k in ("input", "output", "cacheRead", "cacheWrite"):
                    try:
                        state["usage"][k] += int(u.get(k) or 0)
                    except (TypeError, ValueError):
                        pass
                final_text = "".join(c.get("text", "") for c in m.get("content") or []
                                     if isinstance(c, dict) and c.get("type") == "text")
            if not state["streamed"] and final_text.strip():
                out.say(final_text)
                state["streamed"] = True
    return state


def main():
    req, out = Request.load(), Emitter()
    out.ignored([f for f in IGNORED if req.get(f) is not None])

    provider = req.provider
    if not provider or provider.api != "anthropic":
        out.failed("server_error", "journalist-pi runs on the Anthropic API shape only")
        return

    write_models_json(provider.url, req.model or "deepseek-v4-pro")

    names = req.place_inputs()
    prompt = req.prompt
    if not prompt:
        out.failed("invalid_prompt", "the input is the assignment; nothing to report")
        return

    meta = req.get("metadata") or {}
    desk = str(meta.get("desk") or os.environ.get("DESK") or "").strip() or "biofuels"
    task = str(meta.get("task") or "").strip() or "briefing"
    store = req.get("store")

    session_id = req.state.get("session")
    history = req.history()

    head = "Desk: " + desk + "\nTask kind: " + task
    if names:
        head += "\nAttached files (in the workspace): " + ", ".join(names)
    if store is False:
        body, resume_session = prompt, None
    else:
        resume_session = find_session_file(session_id) if session_id else None
        if resume_session:
            body = prompt
        elif history:
            body = ("Earlier conversation (continued from another harness or session):\n\n"
                    + req.transcript() + "\n\nNew assignment: " + prompt)
        else:
            body = prompt

    cmd = [PI, "--offline", "--mode", "json", "-p",
           "--provider", "anthropic",
           "--model", req.model or "deepseek-v4-pro",
           "--api-key", provider.token]
    if req.instructions:
        cmd += ["--append-system-prompt", req.instructions]
    effort = req.reasoning_effort
    if effort in THINKING:
        cmd += ["--thinking", THINKING[effort]]
    if resume_session:
        cmd += ["--session", resume_session]
    elif store is False:
        cmd += ["--no-session"]
    cmd += [head + "\n\nAssignment: " + body]

    env = os.environ.copy()
    env.update({"PI_SKIP_VERSION_CHECK": "1", "PI_OFFLINE": "1",
                "MPLCONFIGDIR": str(req.workspace / ".mplconfig"), "DESK": desk})
    venv_bin = os.path.join(HG_TOOLS, "venv", "bin")
    if os.path.isdir(venv_bin):
        env["PATH"] = venv_bin + os.pathsep + env.get("PATH", "")

    out.log("pi run: model=%s desk=%s task=%s resume=%s" % (req.model, desk, task, bool(resume_session)))

    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            stdin=subprocess.DEVNULL, env=env, cwd=str(req.workspace))
    lines_q = queue.Queue()
    stderr_lines = []

    def _stdout_reader():
        for raw in proc.stdout:
            lines_q.put(raw.decode("utf-8", "replace"))
        lines_q.put(None)

    def _stderr_reader():
        for raw in proc.stderr:
            stderr_lines.append(raw.decode("utf-8", "replace"))

    threading.Thread(target=_stdout_reader, daemon=True).start()
    threading.Thread(target=_stderr_reader, daemon=True).start()

    deadline = time.monotonic() + TURN_TIMEOUT
    interrupted = {"value": False}

    def _on_term(signum, frame):
        interrupted["value"] = True
        if proc.poll() is None:
            proc.terminate()

    old = signal.signal(signal.SIGTERM, _on_term)

    def lines():
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                interrupted["value"] = True
                if proc.poll() is None:
                    proc.terminate()
                return
            try:
                item = lines_q.get(timeout=min(remaining, 5.0))
            except queue.Empty:
                continue
            if item is None:
                return
            yield item

    try:
        state = map_stream(lines(), out, save_session=lambda sid: req.state.set("session", sid))
    finally:
        signal.signal(signal.SIGTERM, old)
        if proc.poll() is None:
            proc.wait()

    stderr = "\n".join(stderr_lines)
    for raw in stderr.strip().splitlines():
        out.log("pi stderr " + raw[:300])

    if state["error"]:
        out.failed(_error_code(state["error"]), state["error"][:500],
                   metadata={"desk": desk, "task": task})
    elif state["ended"]:
        u = state["usage"]
        out.done(input=u["input"] + u["cacheRead"] + u["cacheWrite"], output=u["output"],
                 cached=u["cacheRead"], cache_write=u["cacheWrite"],
                 metadata={"desk": desk, "task": task})
    elif interrupted["value"]:
        out.failed("interrupted", "pi was stopped before it finished the assignment")
    else:
        code = "rate_limit_exceeded" if "429" in stderr else "server_error"
        msg = (stderr.strip().splitlines() or ["pi exited without finishing"])[-1][:500]
        out.failed(code, msg or "pi exited without finishing")


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# Install the pi coding agent CLI (pinned) and the chart toolchain (pandas + matplotlib) into $HG_TOOLS.
set -euo pipefail

VERSION="${HG_PACKAGE_VERSION%-*}"     # e.g. 0.73.1 from "0.73.1-1"
TOOLS="${HG_TOOLS:?}"

# pi: the vendor's documented install, pinned. The bin shim lands in $TOOLS/bin/pi.
npm install -g --prefix "$TOOLS" --no-audit --no-fund --loglevel=error \
  "@mariozechner/pi-coding-agent@${VERSION}"

# pandas + matplotlib for the desk charts, in a venv so the agent's `python3` finds them at run time.
python3 -m venv "$TOOLS/venv"
"$TOOLS/venv/bin/pip" install --no-cache-dir --disable-pip-version-check \
  "pandas==3.1.1" "matplotlib==3.11.2"

echo "installed: pi $("$TOOLS/bin/pi" --version)"
"$TOOLS/venv/bin/python" -c 'import pandas, matplotlib; print(f"installed: pandas {pandas.__version__}, matplotlib {matplotlib.__version__}")'

#!/usr/bin/env bash
set -euo pipefail

VER="${HG_PACKAGE_VERSION%-*}"
mkdir -p "$HG_TOOLS"

if [ ! -x "$HG_TOOLS/node_modules/.bin/pi" ]; then
  npm install --no-audit --no-fund --prefix "$HG_TOOLS" "@mariozechner/pi-coding-agent@$VER"
fi

if [ ! -x "$HG_TOOLS/venv/bin/python3" ]; then
  python3 -m venv "$HG_TOOLS/venv"
  "$HG_TOOLS/venv/bin/pip" install --no-cache-dir --quiet matplotlib pandas
fi

PI_VERSION="$("$HG_TOOLS/node_modules/.bin/pi" --version 2>&1 | tail -1)"
CHARTING="$("$HG_TOOLS/venv/bin/python3" -c 'import matplotlib, pandas; print("matplotlib", matplotlib.__version__, "pandas", pandas.__version__)')"
echo "installed: pi $PI_VERSION; $CHARTING"
